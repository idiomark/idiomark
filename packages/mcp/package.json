{
  "name": "@idiomark/mcp",
  "version": "0.1.0",
  "description": "Idiomark MCP Server - Context7 for personality. Single package with Context (read-only) and Engine (generative) modes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "idiomark-mcp": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@idiomark/core": "workspace:*",
    "@idiomark/inference": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "idiomark",
    "mcp",
    "personality",
    "context",
    "model-context-protocol",
    "ai",
    "llm",
    "ollama",
    "anthropic",
    "openai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idiomark/idiomark.git",
    "directory": "packages/mcp"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://github.com/idiomark/idiomark#readme",
  "bugs": {
    "url": "https://github.com/idiomark/idiomark/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}