{
  "name": "@idiomark/projectors",
  "license": "MIT",
  "version": "0.1.3",
  "description": "Idiomark Projectors - Apply personalities to external systems (MCP, UCP, HTTP, Gaming)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.mts"
    },
    "./mcp": {
      "import": "./dist/mcp/index.js",
      "types": "./dist/mcp/index.d.mts"
    },
    "./ucp": {
      "import": "./dist/ucp/index.js",
      "types": "./dist/ucp/index.d.mts"
    },
    "./http": {
      "import": "./dist/http/index.js",
      "types": "./dist/http/index.d.mts"
    },
    "./gaming": {
      "import": "./dist/gaming/index.js",
      "types": "./dist/gaming/index.d.ts"
    },
    "./gaming/minecraft": {
      "import": "./dist/gaming/minecraft/index.js",
      "types": "./dist/gaming/minecraft/index.d.ts"
    },
    "./gaming/roblox": {
      "import": "./dist/gaming/roblox/index.js",
      "types": "./dist/gaming/roblox/index.d.ts"
    },
    "./gaming/vrchat": {
      "import": "./dist/gaming/vrchat/index.js",
      "types": "./dist/gaming/vrchat/index.d.ts"
    },
    "./gaming/fortnite": {
      "import": "./dist/gaming/fortnite/index.js",
      "types": "./dist/gaming/fortnite/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@idiomark/core": "workspace:*",
    "@idiomark/inference": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idiomark/idiomark.git",
    "directory": "packages/projectors"
  },
  "homepage": "https://github.com/idiomark/idiomark#readme",
  "bugs": {
    "url": "https://github.com/idiomark/idiomark/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}